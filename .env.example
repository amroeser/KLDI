# Copy this file to .env and fill in your credentials
OPENAI_API_KEY=put-your-api-key-here
# Optional: override the default model (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# Optional: override the inference base URL (defaults to the OpenAI API)
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Backend- und Frontend-Ports konfigurieren
# Backend-Port für FastAPI (Default in start.sh: 8101)
BACKEND_PORT=8101
# Basis-Port für das Frontend; start.sh sucht einen freien Port ab hier (Default: 5500)
FRONTEND_PORT_BASE=5500

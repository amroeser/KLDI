# Copy this file to .env and fill in your credentials
OPENAI_API_KEY=put-your-api-key-here
# Optional: override the default model (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# Optional: override the inference base URL (defaults to the OpenAI API)
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Parallelisierungs- und Performance-Settings
# Intra-Run-Parallelität im Backend (Anzahl gleichzeitiger Dokumente)
PARALLELISM=10
# Maximale Anzahl Paraphrasier-Iterationen pro Dokument im Backend
MAX_PARAPHRASE_ITERATIONS=5
# Parallelität für batch_paraphrase im ParaphraseAgent
PARAPHRASE_BATCH_PARALLELISM=4
# Parallelität für batch_paraphrase im ParaphraseOrchestrator
ORCHESTRATOR_BATCH_PARALLELISM=4

# Optional: Backend- und Frontend-Ports konfigurieren
# Backend-Port für FastAPI (Default in start.sh: 8101)
BACKEND_PORT=8101
# Basis-Port für das Frontend; start.sh sucht einen freien Port ab hier (Default: 5500)
FRONTEND_PORT_BASE=5500
